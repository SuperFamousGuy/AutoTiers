# Terraform provider plugins and module downloads (regenerated by `terraform init`)
.terraform/

# Local state (use remote state in production)
terraform.tfstate
terraform.tfstate.backup

# tfvars files often contain secrets — do not commit
*.tfvars
*.tfvars.json

# Override files are local-only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output
*.tfplan

# Crash logs
crash.log
crash.*.log
