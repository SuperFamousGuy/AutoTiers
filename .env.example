# Copy this file to .env to override docker-compose defaults.
# All values are optional — docker-compose.yml has sensible defaults for local dev.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=autotiers
POSTGRES_PORT=5432

API_PORT=8000

WEB_PORT=5173

# Set false on first start if you don't want sample data
SEED_DEV_DATA=true
